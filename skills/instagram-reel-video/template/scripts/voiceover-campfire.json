{
  "piper": "tools/piper/piper",
  "model": "tools/piper/voices/ru_RU-denis-medium.onnx",
  "ffmpeg": "ffmpeg",
  "fps": 30,
  "audioDir": "voiceover/campfire",
  "json": "src/voiceover-campfire.json",
  "defaults": {
    "length": 0.8,
    "noise": 0.75,
    "noiseW": 0.9,
    "gap": 0.14
  },
  "scenes": [
    {
      "id": "intro",
      "segments": [
        {
          "text": "Клод теперь ведёт твой Инстаграм.",
          "gap": 0.25
        },
        {
          "text": "Три фишки.",
          "gap": 0.15
        },
        {
          "text": "И третья — самая важная.",
          "length": 0.92
        }
      ]
    },
    {
      "id": "s01",
      "segments": [
        {
          "text": "Первое.",
          "gap": 0.2
        },
        {
          "text": "Пишет сценарии рилс по секундам.",
          "gap": 0.2
        },
        {
          "text": "Где хук, где пауза, где призыв."
        }
      ]
    },
    {
      "id": "s02",
      "segments": [
        {
          "text": "Второе.",
          "gap": 0.2
        },
        {
          "text": "Делает карусели под сохранения,",
          "gap": 0.1
        },
        {
          "text": "а не под лайки."
        }
      ]
    },
    {
      "id": "algo",
      "segments": [
        {
          "text": "Потому что знает, что реально считает алгоритм.",
          "gap": 0.25
        },
        {
          "text": "Досмотры.",
          "gap": 0.18
        },
        {
          "text": "Репосты.",
          "gap": 0.18
        },
        {
          "text": "Сохранения."
        }
      ]
    },
    {
      "id": "s03",
      "segments": [
        {
          "text": "И третье.",
          "gap": 0.2
        },
        {
          "text": "Без ботов и накрутки,",
          "gap": 0.1
        },
        {
          "text": "которые режут охваты.",
          "length": 0.92
        }
      ]
    },
    {
      "id": "install",
      "segments": [
        {
          "text": "Установка?",
          "gap": 0.3
        },
        {
          "text": "Одна минута.",
          "gap": 0.2
        },
        {
          "text": "Прямо в Клоде."
        }
      ]
    },
    {
      "id": "madeby",
      "segments": [
        {
          "text": "Кстати.",
          "gap": 0.2
        },
        {
          "text": "Это видео целиком сделал Клод.",
          "gap": 0.25
        },
        {
          "text": "Озвучку.",
          "gap": 0.12
        },
        {
          "text": "Анимацию.",
          "gap": 0.12
        },
        {
          "text": "И звук.",
          "gap": 0.25
        },
        {
          "text": "Без сторонних сервисов и лишних подписок."
        }
      ]
    },
    {
      "id": "question",
      "segments": [
        {
          "text": "Хочешь себе такого помощника?",
          "length": 0.9
        }
      ]
    },
    {
      "id": "cta",
      "segments": [
        {
          "text": "Пиши «Клод» в комментариях.",
          "gap": 0.2
        },
        {
          "text": "Пришлю ссылку и инструкцию."
        }
      ]
    }
  ]
}
